object frmConfigDB: TfrmConfigDB
  Left = 320
  Height = 520
  Top = 120
  Width = 540
  BorderIcons = [biSystemMenu, biMinimize]
  BorderStyle = bsSingle
  Caption = 'Configurações de Conexão & PIX'
  ClientHeight = 520
  ClientWidth = 540
  Color = 2105376
  Font.Color = clWhite
  Font.Height = -13
  Font.Name = 'Segoe UI'
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  object pnlHeader: TPanel
    Left = 0
    Height = 60
    Top = 0
    Width = 540
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 60
    ClientWidth = 540
    Color = 1315860
    ParentBackground = False
    ParentColor = False
    TabOrder = 0
    object lblTitle: TLabel
      Left = 16
      Height = 28
      Top = 16
      Width = 460
      Caption = '⚙️ Configurações Gerais (Banco & PIX)'
      Font.Color = clWhite
      Font.Height = -20
      Font.Name = 'Segoe UI'
      Font.Style = [fsBold]
      ParentFont = False
    end
  end
  object pgcConfig: TPageControl
    Left = 0
    Height = 460
    Top = 60
    Width = 540
    ActivePage = tabDBConfig
    Align = alClient
    TabIndex = 0
    TabOrder = 1
    object tabDBConfig: TTabSheet
      Caption = '🗄️ Conexão Firebird'
      object lblHost: TLabel
        Left = 16
        Height = 18
        Top = 16
        Width = 140
        Caption = 'Servidor (Host / IP):'
      end
      object edtHost: TEdit
        Left = 16
        Height = 30
        Top = 38
        Width = 350
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 0
        Text = 'localhost'
      end
      object lblPort: TLabel
        Left = 380
        Height = 18
        Top = 16
        Width = 35
        Caption = 'Porta:'
      end
      object edtPort: TEdit
        Left = 380
        Height = 30
        Top = 38
        Width = 120
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 1
        Text = '3050'
      end
      object lblDBPath: TLabel
        Left = 16
        Height = 18
        Top = 80
        Width = 230
        Caption = 'Caminho do Banco de Dados (.fdb):'
      end
      object edtDBPath: TEdit
        Left = 16
        Height = 30
        Top = 102
        Width = 484
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 2
        Text = 'C:\Fontes\Componentes\TLazarusBakcup\Database\LazarusBackup.fdb'
      end
      object lblUser: TLabel
        Left = 16
        Height = 18
        Top = 145
        Width = 110
        Caption = 'Usuário (SYSDBA):'
      end
      object edtUser: TEdit
        Left = 16
        Height = 30
        Top = 167
        Width = 230
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 3
        Text = 'SYSDBA'
      end
      object lblPassword: TLabel
        Left = 270
        Height = 18
        Top = 145
        Width = 40
        Caption = 'Senha:'
      end
      object edtPassword: TEdit
        Left = 270
        Height = 30
        Top = 167
        Width = 230
        Color = 3026478
        EchoMode = emPassword
        Font.Color = clWhite
        ParentFont = False
        PasswordChar = '*'
        TabOrder = 4
        Text = 'masterkey'
      end
      object lblCharset: TLabel
        Left = 16
        Height = 18
        Top = 210
        Width = 100
        Caption = 'Tipo de Charset:'
      end
      object cboCharset: TComboBox
        Left = 16
        Height = 30
        Top = 232
        Width = 230
        Color = 3026478
        Font.Color = clWhite
        ItemHeight = 20
        Items.Strings = (
          'UTF8'
          'WIN1252'
          'ISO8859_1'
          'NONE'
        )
        ParentFont = False
        Style = csDropDownList
        TabOrder = 5
      end
      object lblClientLib: TLabel
        Left = 270
        Height = 18
        Top = 210
        Width = 160
        Caption = 'Biblioteca Client (DLL/so):'
      end
      object edtClientLib: TEdit
        Left = 270
        Height = 30
        Top = 232
        Width = 230
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 6
        Text = 'C:\Program Files (x86)\Firebird\Firebird_5_0\fbclient.dll'
      end
      object btnTest: TButton
        Left = 16
        Height = 36
        Top = 280
        Width = 484
        Caption = '🔌 Testar Conexão com Banco de Dados'
        Font.Color = clWhite
        Font.Style = [fsBold]
        ParentFont = False
        TabOrder = 7
        OnClick = btnTestClick
      end
      object btnSave: TButton
        Left = 16
        Height = 40
        Top = 330
        Width = 234
        Caption = '💾 Salvar Config Conexão'
        Font.Color = clWhite
        Font.Style = [fsBold]
        ParentFont = False
        TabOrder = 8
        OnClick = btnSaveClick
      end
      object btnCancel: TButton
        Left = 266
        Height = 40
        Top = 330
        Width = 234
        Caption = 'Cancelar'
        TabOrder = 9
        OnClick = btnCancelClick
      end
    end
    object tabPIXConfig: TTabSheet
      Caption = '🔑 Configuração do PIX'
      object lblPixKey: TLabel
        Left = 16
        Height = 18
        Top = 16
        Width = 220
        Caption = 'Chave PIX (E-mail / CPF / CNPJ / Telefone):'
      end
      object edtPixKey: TEdit
        Left = 16
        Height = 30
        Top = 38
        Width = 350
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 0
        Text = 'financeiro@lazarusportable.com.br'
      end
      object lblPixType: TLabel
        Left = 380
        Height = 18
        Top = 16
        Width = 80
        Caption = 'Tipo de Chave:'
      end
      object cboPixType: TComboBox
        Left = 380
        Height = 30
        Top = 38
        Width = 120
        Color = 3026478
        Font.Color = clWhite
        ItemHeight = 20
        Items.Strings = (
          'EMAIL'
          'CPF'
          'CNPJ'
          'TELEFONE'
          'ALEATORIA'
        )
        ParentFont = False
        Style = csDropDownList
        TabOrder = 1
      end
      object lblPixHolder: TLabel
        Left = 16
        Height = 18
        Top = 80
        Width = 140
        Caption = 'Titular / Razão Social:'
      end
      object edtPixHolder: TEdit
        Left = 16
        Height = 30
        Top = 102
        Width = 240
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 2
        Text = 'Lazarus Portable Manager'
      end
      object lblPixBank: TLabel
        Left = 270
        Height = 18
        Top = 80
        Width = 120
        Caption = 'Banco / Instituição:'
      end
      object edtPixBank: TEdit
        Left = 270
        Height = 30
        Top = 102
        Width = 230
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 3
        Text = 'Banco Inter'
      end
      object lblPixAmount: TLabel
        Left = 16
        Height = 18
        Top = 145
        Width = 140
        Caption = 'Valor da Licença (R$):'
      end
      object edtPixAmount: TEdit
        Left = 16
        Height = 30
        Top = 167
        Width = 240
        Color = 3026478
        Font.Color = clWhite
        ParentFont = False
        TabOrder = 4
        Text = '49,90'
      end
      object lblPixInst: TLabel
        Left = 16
        Height = 18
        Top = 210
        Width = 160
        Caption = 'Instruções para o Pagador:'
      end
      object memoPixInst: TMemo
        Left = 16
        Height = 70
        Top = 232
        Width = 484
        Color = 3026478
        Font.Color = clWhite
        Lines.Strings = (
          'Após efetuar o PIX, anexe o comprovante na tela de licença para liberação.'
        )
        ParentFont = False
        TabOrder = 5
      end
      object btnSavePix: TButton
        Left = 16
        Height = 42
        Top = 320
        Width = 484
        Caption = '💾 Salvar Chave e Dados do PIX no Banco'
        Font.Color = clWhite
        Font.Style = [fsBold]
        OnClick = btnSavePixClick
        ParentFont = False
        TabOrder = 6
      end
    end
  end
end
